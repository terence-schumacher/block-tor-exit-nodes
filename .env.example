# Fetcher
# Directory for tor-exit-nodes.txt and .last-fetch-time (default: ./data)
# TOR_LIST_OUTPUT_DIR=./data

# Datadog (optional; if unset, metrics/events are skipped)
# DD_API_KEY=your-datadog-api-key

# Example app (example_app.py)
# Path to the blocklist file (default: ./data/tor-exit-nodes.txt)
# TOR_LIST_PATH=./data/tor-exit-nodes.txt
# Set to 1 to log blocks but not return 403 (monitor-only)
# TOR_BLOCK_MONITOR_ONLY=0
# Port for the example server (default: 3000)
# PORT=3000
